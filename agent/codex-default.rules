# Block common network and remote-access tools (including absolute paths).
prefix_rule(pattern=[["curl", "/usr/bin/curl"]], decision="forbidden", justification="Network fetch is not allowed.")
prefix_rule(pattern=[["wget", "/usr/bin/wget"]], decision="forbidden", justification="Network fetch is not allowed.")
prefix_rule(pattern=[["ssh", "/usr/bin/ssh"]], decision="forbidden", justification="Remote access is not allowed.")
prefix_rule(pattern=[["scp", "/usr/bin/scp"]], decision="forbidden", justification="Remote file transfer is not allowed.")
prefix_rule(pattern=[["sftp", "/usr/bin/sftp"]], decision="forbidden", justification="Remote file transfer is not allowed.")
prefix_rule(pattern=[["rsync", "/usr/bin/rsync"]], decision="forbidden", justification="Remote sync is not allowed.")
prefix_rule(pattern=[["nc", "/usr/bin/nc"]], decision="forbidden", justification="Raw network sockets are not allowed.")
prefix_rule(pattern=[["netcat", "/usr/bin/netcat"]], decision="forbidden", justification="Raw network sockets are not allowed.")
prefix_rule(pattern=[["telnet", "/usr/bin/telnet"]], decision="forbidden", justification="Raw network access is not allowed.")
prefix_rule(pattern=["openssl", "s_client"], decision="forbidden", justification="Raw network access is not allowed.")

# Block networked git operations while keeping local inspection commands available.
prefix_rule(pattern=["git", "fetch"], decision="forbidden", justification="Network git access is not allowed.")
prefix_rule(pattern=["git", "pull"], decision="forbidden", justification="Network git access is not allowed.")
prefix_rule(pattern=["git", "clone"], decision="forbidden", justification="Network git access is not allowed.")
prefix_rule(pattern=["git", "push"], decision="forbidden", justification="Network git access is not allowed.")
prefix_rule(pattern=["git", "ls-remote"], decision="forbidden", justification="Network git access is not allowed.")
prefix_rule(pattern=["git", "remote"], decision="forbidden", justification="Remote git operations are not allowed.")
prefix_rule(pattern=["git", "submodule"], decision="forbidden", justification="Submodule commands may access network and are not allowed.")
prefix_rule(pattern=["git", "archive", "--remote"], decision="forbidden", justification="Remote git operations are not allowed.")

# Block package managers and download/install paths.
prefix_rule(pattern=["pip", "install"], decision="forbidden", justification="Dependency downloads are not allowed.")
prefix_rule(pattern=["pip", "download"], decision="forbidden", justification="Dependency downloads are not allowed.")
prefix_rule(pattern=["pip", "wheel"], decision="forbidden", justification="Dependency downloads are not allowed.")
prefix_rule(pattern=["python", "-m", "pip", "install"], decision="forbidden", justification="Dependency downloads are not allowed.")
prefix_rule(pattern=["python", "-m", "pip", "download"], decision="forbidden", justification="Dependency downloads are not allowed.")
prefix_rule(pattern=["python", "-m", "pip", "wheel"], decision="forbidden", justification="Dependency downloads are not allowed.")
prefix_rule(pattern=["python3", "-m", "pip", "install"], decision="forbidden", justification="Dependency downloads are not allowed.")
prefix_rule(pattern=["python3", "-m", "pip", "download"], decision="forbidden", justification="Dependency downloads are not allowed.")
prefix_rule(pattern=["python3", "-m", "pip", "wheel"], decision="forbidden", justification="Dependency downloads are not allowed.")
prefix_rule(pattern=["uv", "pip", "install"], decision="forbidden", justification="Dependency downloads are not allowed.")
prefix_rule(pattern=["uv", "pip", "download"], decision="forbidden", justification="Dependency downloads are not allowed.")
prefix_rule(pattern=["uv", "pip", "compile"], decision="forbidden", justification="Dependency resolution against remote indexes is not allowed.")
prefix_rule(pattern=[["npm"]], decision="forbidden", justification="Package manager network access is not allowed.")
prefix_rule(pattern=[["yarn"]], decision="forbidden", justification="Package manager network access is not allowed.")
prefix_rule(pattern=[["pnpm"]], decision="forbidden", justification="Package manager network access is not allowed.")
prefix_rule(pattern=[["apt"]], decision="forbidden", justification="Package manager network access is not allowed.")
prefix_rule(pattern=[["apt-get"]], decision="forbidden", justification="Package manager network access is not allowed.")
prefix_rule(pattern=["poetry", "add"], decision="forbidden", justification="Package manager network access is not allowed.")
prefix_rule(pattern=["poetry", "install"], decision="forbidden", justification="Package manager network access is not allowed.")
prefix_rule(pattern=["conda", "install"], decision="forbidden", justification="Package manager network access is not allowed.")
prefix_rule(pattern=["mamba", "install"], decision="forbidden", justification="Package manager network access is not allowed.")
prefix_rule(pattern=["micromamba", "install"], decision="forbidden", justification="Package manager network access is not allowed.")
