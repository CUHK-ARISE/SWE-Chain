+    c = AtomicFields()
+    ad = attrs.asdict
+
+    for _ in range(ROUNDS):
+        ad(c)
+
+
+def test_astuple_atomic():
+    """
+    Benchmark atomic-only instances.
+    """
+    c = AtomicFields()
+    at = attrs.astuple
+
+    for _ in range(ROUNDS):
+        at(c)

