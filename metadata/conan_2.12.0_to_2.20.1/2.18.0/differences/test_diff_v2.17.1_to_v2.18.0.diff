+        [conf]
+        {% if context == "host" %}
+        user.profile:base = myhost
+        {% elif context == "build" %}
+        user.profile:base = mybuild
+        {% else %}
+        user.profile:base = nocontext
+        [settings]
+        arch = x86
+        {% endif %}
+        """)
