+    c.run("create foo --lockfile=bar.lock --lockfile-partial", assert_error=True)
+    assert "Missing prebuilt package for 'bar/8.0'" in c.out
+
+    c.run("create foo --lockfile=bar.lock --lockfile-partial --build=missing "
