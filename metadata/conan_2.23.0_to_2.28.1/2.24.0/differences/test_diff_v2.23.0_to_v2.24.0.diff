+    c.assert_listed_require({"utils/1.9.0": "Cache"}, python=True)
+    assert "utils/1.8.0" not in c.out
+
+    # This build is reproducible with this lockfile
+    c.run("create foo --lockfile=foo.lock")
+    c.assert_listed_require({"utils/1.9.0": "Cache"}, python=True)
+    assert "utils/1.8.0" not in c.out

