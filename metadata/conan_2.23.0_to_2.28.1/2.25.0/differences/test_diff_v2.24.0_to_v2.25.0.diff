+        from conan.tools.system import PyEnv
+        from conan.tools.layout import basic_layout
+        import platform
+        import os
+
+
+        class PyenvPackage(ConanFile):
+            name = "pip_hello_test"
+            version = "0.1"
+
+            def layout(self):
+                basic_layout(self)
+
+            def generate(self):
+                pip_env = PyEnv(self, py_version="{py_version}")
+                pip_env.install(["{pip_package_folder}"])
+                pip_env.generate()
+                pip_env.run(["--version"])
