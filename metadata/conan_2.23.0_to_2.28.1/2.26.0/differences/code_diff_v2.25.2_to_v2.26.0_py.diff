+            if not deactivation_mode:
+                save(os.path.join(conanfile.generators_folder, "deactivate_{}".format(filename)),
+                     sh_content(deactivates(shs)))
+        if bats:
+            filename = f"conan{group}.bat"
+            deactivate_filename = f"deactivate_{filename}"
