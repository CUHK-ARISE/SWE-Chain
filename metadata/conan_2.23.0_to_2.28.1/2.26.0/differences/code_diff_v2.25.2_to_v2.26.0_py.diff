+                    content += [f'set PATH=%{deactivates_var}%;%PATH%']
+                    content += [f'echo @echo off > "%{deactivates_var}%\\{deactivate_filename}"']
+                    content += [f'echo call "{b}" >> "%{deactivates_var}%\\{deactivate_filename}"'
