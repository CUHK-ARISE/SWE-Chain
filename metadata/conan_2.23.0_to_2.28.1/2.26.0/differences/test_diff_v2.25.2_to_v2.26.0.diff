+            485dad6cb11e2fa99d9afbe44a57a164
+              packages
+                da39a3ee5e6b4b0d3255bfef95601890afd80709
+                  revisions
+                    0ba8627bd47edc3a501e8f0eb9a79e5e
+
+        [Package sign] Summary: OK=2, FAILED=0""")
+    assert expected in c.out
+    c.run("cache verify -l pkglist.json")
+    assert expected in c.out

