+                self._poetry.package.AVAILABLE_PYTHONS,
+                key=lambda v: (v.startswith("3"), -len(v), v),
+                reverse=True,
+            ):
+                if len(suffix) == 1:
+                    if not parse_constraint(f"^{suffix}.0").allows_any(
+                        supported_python
+                    ):
+                        continue
+                elif not supported_python.allows_any(parse_constraint(suffix + ".*")):
+                    continue
