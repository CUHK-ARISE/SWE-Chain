+def to_zarr(
+    dataset: Dataset,
+    store: ZarrStoreLike | None = None,
+    chunk_store: MutableMapping | str | os.PathLike | None = None,
+    mode: ZarrWriteModes | None = None,
+    synchronizer=None,
+    group: str | None = None,
+    encoding: Mapping | None = None,
